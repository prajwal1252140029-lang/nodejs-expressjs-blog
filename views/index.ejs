<%- include('partials/header') %>
<section class="hero">
  <div class="container">
    <p class="eyebrow">CNWT Home Assignment &middot; <%= site.department %></p>
    <h1><%= site.title %></h1>
    <p class="lead">An engineering student's guide to server-side JavaScript: how Node.js and Express.js receive requests, route them, and serve data, including a simulated industrial IoT sensor API.</p>
    <p class="cta">
      <a class="btn primary" href="/blog/<%= post.slug %>">Read the article</a>
      <a class="btn" href="/api/sensors">Try the sensor API</a>
    </p>
  </div>
</section>

<section class="container section">
  <h2>What you will learn</h2>
  <div class="cards three">
    <div class="card"><h3>Node.js</h3><p>A JavaScript runtime built on the V8 engine, using an event-driven, non-blocking model.</p><a href="/blog/<%= post.slug %>#what-is-nodejs">Read section</a></div>
    <div class="card"><h3>Express.js</h3><p>A minimal web framework that adds routing, middleware and clean API handling.</p><a href="/blog/<%= post.slug %>#what-is-expressjs">Read section</a></div>
    <div class="card"><h3>Industrial IoT</h3><p>Temperature, pressure and flow readings served as JSON, clearly labelled as simulated.</p><a href="/blog/<%= post.slug %>#industrial-iot-monitoring-example">Read section</a></div>
  </div>
</section>

<section class="container section">
  <h2>How a request flows through Express</h2>
  <figure class="figure">
    <svg viewBox="0 0 680 150" role="img" aria-labelledby="flow-title flow-desc">
      <title id="flow-title">HTTP request flow</title>
      <desc id="flow-desc">A browser sends a request to Express, which passes it through middleware to a route handler, and returns a response.</desc>
      <defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#0b5d7a"/></marker></defs>
      <g class="svg-box">
        <rect x="10" y="45" width="120" height="60" rx="8"/>
        <rect x="190" y="45" width="140" height="60" rx="8"/>
        <rect x="390" y="45" width="130" height="60" rx="8"/>
        <rect x="570" y="45" width="100" height="60" rx="8"/>
      </g>
      <g class="svg-text" text-anchor="middle">
        <text x="70" y="80">Browser</text>
        <text x="260" y="80">Middleware</text>
        <text x="455" y="80">Route handler</text>
        <text x="620" y="80">Response</text>
      </g>
      <g stroke="#0b5d7a" stroke-width="2" marker-end="url(#arrow)">
        <line x1="130" y1="75" x2="188" y2="75"/>
        <line x1="330" y1="75" x2="388" y2="75"/>
        <line x1="520" y1="75" x2="568" y2="75"/>
      </g>
      <text class="svg-note" x="160" y="35" text-anchor="middle">GET /api</text>
      <text class="svg-note" x="360" y="35" text-anchor="middle">next()</text>
      <text class="svg-note" x="545" y="35" text-anchor="middle">res.json()</text>
    </svg>
    <figcaption>Each request passes through middleware functions before a route handler sends the response.</figcaption>
  </figure>
</section>
<%- include('partials/footer') %>
